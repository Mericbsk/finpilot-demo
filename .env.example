# FinPilot Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# === Authentication (REQUIRED) ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FINPILOT_SECRET_KEY=your_64_character_hex_secret_here

# === LLM API Keys ===
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === Data Providers (Optional) ===
POLYGON_API_KEY=your_polygon_api_key_here
NEWS_API_KEY=your_news_api_key_here

# === MLflow (Optional) ===
MLFLOW_TRACKING_URI=http://localhost:5000

# === Langfuse LLM Observability (Optional) ===
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# === Redis Cache (Optional) ===
REDIS_URL=redis://localhost:6379/0

# === Alpaca Paper Trading (Sprint 21) ===
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
FINPILOT_EXECUTION_MODE=dry_run
FINPILOT_RECONCILE_INTERVAL_SECONDS=60

# === Sentry Error Tracking (Optional — free tier works) ===
# Get DSN from https://sentry.io (free account → create project → copy DSN)
SENTRY_DSN=https://your_key@o0.ingest.sentry.io/your_project_id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=finpilot@1.1.0

# For PostgreSQL: uncomment below and run: docker-compose --profile db up -d
# DATABASE_URL=postgresql://finpilot:finpilot_dev_2026@localhost:5432/finpilot  # pragma: allowlist secret
# POSTGRES_PASSWORD=finpilot_dev_2026  # pragma: allowlist secret

# ── Early-detection ladder (scanner) ─────────────────────────────────────────
# When 1, scanner.evaluate attaches a WATCH/SETUP/TRIGGER/CONFIRM tier + the
# contraction / rvol-acceleration / range-expansion features to each result.
# Additive only — does NOT change entry_ok or composite_score. Default OFF;
# enable in shadow mode to measure tiers via the Edge Report before promoting.
FINPILOT_ENABLE_EARLY_TIER=0

# ── Distribution layer (daily brief + web demo snapshot) ─────────────────────
# Master switch for the dist_draft (07:50), dist_publish (08:30) and
# dist_weekly (Sun 10:00, Europe/Vienna) scheduler jobs. Default OFF.
FINPILOT_ENABLE_DISTRIBUTION=0
# Premium brief draft'ı da üret (private kanal açıldığında 1 yap).
FINPILOT_ENABLE_PREMIUM_BRIEF=0
# Public kanal (@kanaladi veya -100... id) — brifin yayınlandığı yer.
TELEGRAM_CHANNEL_ID=
# Private premium kanal id'si.
TELEGRAM_PREMIUM_CHANNEL_ID=
# Kanalın davet linki (bot /start mesajında paylaşılır).
TELEGRAM_CHANNEL_LINK=
# Onay komutlarını (ONAYLA/RED) kabul eden admin user id (boşsa CHAT_ID kullanılır).
TELEGRAM_ADMIN_ID=
# Web sitesi (brif linklerinde kullanılır).
FINPILOT_SITE_URL=https://www.finpilot.at
# Snapshot'ın kopyalandığı web public dosyası.
FINPILOT_WEB_SNAPSHOT=web/public/demo_snapshot.json
# Opsiyonel: snapshot push sonrası çalışacak deploy komutu (örn. vercel deploy).
FINPILOT_WEB_PUBLISH_CMD=
# Karne verisi için lokal API tabanı.
FINPILOT_LOCAL_API=http://localhost:8000/api/v1

# ── Stripe (premium) ─────────────────────────────────────────────────────────
# Webhook imza doğrulaması (Stripe dashboard → webhook endpoint secret).
STRIPE_WEBHOOK_SECRET=

# ── Web (Next.js, build-time) ────────────────────────────────────────────────
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/<kanal>
# NEXT_PUBLIC_STRIPE_LINK_FOUNDING=
# NEXT_PUBLIC_STRIPE_LINK_MONTHLY=
# Prod CORS (public API'yi internete açarken ZORUNLU):
# CORS_ORIGINS=https://finpilot.at,https://www.finpilot.at
# Vercel'de web build'ine public API adresi (py-api proxy'si Vercel'de çalışmaz):
# NEXT_PUBLIC_API_URL=https://api.finpilot.at

# ── EODHD News Sentiment (scanner) ───────────────────────────────────────────
# When 1 AND EODHD_API_KEY is set, scanner reads a scheduler-populated sentiment
# cache (data/sentiment_cache.json) and feeds a 0..1 value (0.5=neutral) into
# the composite score via score_engine's ±0.5 hook. Hot-path safe (cache-only,
# no per-symbol network in the scan). Default OFF; measure via Edge Report
# (bucket by sentiment) before trusting it in live decisions.
FINPILOT_ENABLE_SENTIMENT=0

# Ranking guard: 0 uses legacy_quality; 1 retains legacy composite ranking.
FINPILOT_ENABLE_LEGACY_COMPOSITE_RANKING=0
# Execution-first selection policy. Enable after reviewing shadow ledger output.
FINPILOT_ENABLE_EXECUTION_POLICY=0
FINPILOT_ENABLE_PORTFOLIO_ADV_LIMIT=1
FINPILOT_MAX_POSITION_ADV_FRACTION=0.005
# EODHD_API_KEY=your_key_here   # required for the sentiment refresh job
